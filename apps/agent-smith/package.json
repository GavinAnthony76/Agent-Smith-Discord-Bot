{
  "name": "@workspace/agent-smith", "version": "1.0.0", "private": true, "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/bot.js",
    "progression:migrate": "node --env-file-if-exists=.env src/progression-migrate.js",
    "progression:roles": "node --env-file-if-exists=.env src/progression-roles.js",
    "db:migrate": "node --env-file-if-exists=.env src/migrate.js",
    "discord:bootstrap": "node --env-file-if-exists=.env src/provision.js bootstrap",
    "discord:audit": "node --env-file-if-exists=.env src/provision.js audit",
    "onboarding:refresh": "node --env-file-if-exists=.env src/refresh-onboarding.js",
    "access-requests:refresh": "node --env-file-if-exists=.env src/refresh-access-requests.js",
    "onboarding:native": "node --env-file-if-exists=.env src/native-admin.js",
    "onboarding:cutover": "node --env-file-if-exists=.env src/native-cutover.js",
    "discord:register": "node --env-file-if-exists=.env src/register.js",
    "feeds:run": "node --env-file-if-exists=.env src/feeds.js",
    "test": "node --experimental-vm-modules --test test/*.test.js",
    "preflight": "node src/preflight.js",
    "security:source": "node src/security-source-check.js"
  },
  "dependencies": { "discord.js": "14.25.1", "pg": "8.16.3", "rss-parser": "3.13.0" }
}
